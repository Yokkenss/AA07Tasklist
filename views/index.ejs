<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meine Aufgaben</title>
    <link rel="stylesheet" href="/css/styles.css?v=6">
</head>
<body>
    <main class="page">
        <header class="page-header">
            <div>
                <h1>Meine Aufgaben</h1>
            </div>
            <a href="/tasks/new" class="button button-primary"><span aria-hidden="true">+</span> Neue Aufgabe</a>
        </header>
        <section class="panel" aria-labelledby="task-list-title">
            <div class="panel-header">
                <h2 id="task-list-title">Alle Aufgaben</h2>
            </div>
            <% if (tasks.length === 0) { %>
            <div class="empty-state">
                <p>Noch keine Aufgaben.</p>
                <a href="/tasks/new" class="button button-primary">Neue Aufgabe</a>
            </div>
            <% } else { %>
            <div class="table-scroll" role="region" aria-label="Aufgabenübersicht" tabindex="0">
            <table>
            <thead>
                <tr>
                    <th scope="col">Titel</th>
                    <th scope="col">Beschreibung</th>
                    <th scope="col">Fällig am</th>
                    <th scope="col">Status</th>
                    <th scope="col">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                <% tasks.forEach(task => { %> 
                <tr class="<%= task.status === 'erledigt' ? 'task-completed' : '' %>">
                    <td class="task-title"><%= task.title %></td>
                    <td class="task-description"><%= task.description %></td>
                    <td class="task-date"><%= task.dueDate %></td>
                    <td class="status"><%= task.status %></td>
                    <td>
                        <div class="task-actions">
                        <form method="POST" action="/tasks/<%= task.id %>/complete">
                            <button type="submit" class="button button-success" aria-label="Aufgabe <%= task.title %> erledigen">Erledigen</button>
                        </form>
                        <form method="POST" action="/tasks/<%= task.id %>/delete">
                            <button type="submit" class="button button-danger" aria-label="Aufgabe <%= task.title %> löschen">Löschen</button>
                        </form>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
            </table>
            </div>
            <% } %>
        </section>
    </main>
</body>
</html>
